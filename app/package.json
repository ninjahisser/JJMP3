{
  "name": "jjmp3",
  "productName": "JJMP3",
  "version": "1.0.2",
  "description": "Desktop app for the JJMP3 pocket player: add music from YouTube and Spotify, playlists, playback and setup.",
  "author": "ninjahisser",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win",
    "local": "powershell -ExecutionPolicy Bypass -File build-local.ps1",
    "icons": "node_modules/electron/dist/electron.exe scripts/make-icons.mjs"
  },
  "build": {
    "appId": "dev.jjmp3.app",
    "productName": "JJMP3",
    "copyright": "Copyright © 2026 Seth Van den Bossche",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["out/**", "resources/**", "package.json"],
    "win": {
      "icon": "build/icon.ico",
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "JJMP3-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JJMP3",
      "artifactName": "JJMP3-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "serialport": "^13.0.0",
    "yauzl": "^3.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
